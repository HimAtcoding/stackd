{
  "name": "stackd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve@14 out -l 4000",
    "lint": "eslint",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare-assets",
    "prebuild": "npm run prepare-assets",
    "postbuild": "node scripts/fix-export-segments.mjs && node scripts/check-service-key.mjs",
    "test:db": "node scripts/test-migrations.mjs",
    "import": "node scripts/import/run.mjs",
    "import:verify": "node scripts/import/verify.mjs",
    "test:import": "node scripts/import/test.mjs",
    "test:oauth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-oauth.mjs",
    "apple:secret": "node scripts/make-apple-secret.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.117.2",
    "motion": "^14.0.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sharp": "^0.35.4",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
